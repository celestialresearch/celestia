default 90
cache-max-age-minutes 1440
# Platform syscall branches retain behavioural tests without test-only I/O hooks.
package celestia.research/governed-operation/internal/attemptstore 83.5
# Native Win32 failure injection would weaken the production ownership boundary.
package celestia.research/governed-operation/internal/processsupervision 75
# The application path is exercised end to end; unreachable native failures stay below it.
package celestia.research/governed-operation/internal/urloperation 86
